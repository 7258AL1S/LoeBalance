<Window x:Class="LoeBalance.Desktop.Wpf.Views.TaskbarBalanceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="120"
        Height="24"
        AllowsTransparency="True"
        Background="Transparent"
        Focusable="False"
        ResizeMode="NoResize"
        ShowActivated="False"
        ShowInTaskbar="False"
        SizeToContent="Manual"
        SnapsToDevicePixels="True"
        Title="LoeBalance 任务栏余额"
        Topmost="True"
        WindowStartupLocation="Manual"
        WindowStyle="None">
    <Border x:Name="ReadoutSurface"
            Padding="7,0"
            Background="#F21A2638"
            BorderBrush="#33FFFFFF"
            BorderThickness="1"
            CornerRadius="4">
        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" VerticalAlignment="Center">
            <Ellipse x:Name="ConnectionDot"
                     Width="7"
                     Height="7"
                     Margin="0,0,5,0"
                     VerticalAlignment="Center" />
            <TextBlock x:Name="BalanceText"
                       FontFamily="Consolas, Segoe UI"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="#F2F4F8"
                       Text="--"
                       VerticalAlignment="Center" />
        </StackPanel>
    </Border>
</Window>
