<Window x:Class="LoeBalance.Desktop.Wpf.Views.TaskbarBalanceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:LoeBalance.Desktop.Wpf.Views"
        Width="160"
        Height="126"
        AllowsTransparency="True"
        Background="Transparent"
        Focusable="False"
        ResizeMode="NoResize"
        ShowActivated="False"
        ShowInTaskbar="False"
        SizeToContent="Manual"
        SnapsToDevicePixels="True"
        Title="LoeBalance 任务栏余额"
        Topmost="True"
        WindowStartupLocation="Manual"
        WindowStyle="None">
    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Balance pill -->
            <ColumnDefinition Width="Auto" />
            <!-- Animation strip reserved for the floating debit/credit numbers -->
            <ColumnDefinition Width="54" />
        </Grid.ColumnDefinitions>

        <Border x:Name="ReadoutSurface"
                Grid.Column="0"
                Height="24"
                Padding="7,0"
                VerticalAlignment="Center"
                Background="#F21A2638"
                BorderBrush="#33FFFFFF"
                BorderThickness="1"
                CornerRadius="4">
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse x:Name="ConnectionDot"
                         Width="7"
                         Height="7"
                         Margin="0,0,5,0"
                         VerticalAlignment="Center" />
                <TextBlock x:Name="BalanceText"
                           FontFamily="Consolas, Segoe UI"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="#F2F4F8"
                           Text="--"
                           TextWrapping="NoWrap"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <views:DamageStreamCanvas x:Name="DamageStream"
                                  Grid.Column="1"
                                  Width="54"
                                  Height="126"
                                  ClipToBounds="True"
                                  HorizontalAlignment="Right"
                                  IsHitTestVisible="False"
                                  VerticalAlignment="Center" />
    </Grid>
</Window>
