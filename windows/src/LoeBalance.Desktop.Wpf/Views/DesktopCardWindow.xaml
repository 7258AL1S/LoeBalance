<Window x:Class="LoeBalance.Desktop.Wpf.Views.DesktopCardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:LoeBalance.Desktop.Wpf.Views"
        Width="326"
        Height="218"
        AllowsTransparency="True"
        Background="Transparent"
        Focusable="False"
        ResizeMode="NoResize"
        ShowActivated="False"
        ShowInTaskbar="False"
        SnapsToDevicePixels="True"
        Title="Sub2API 余额"
        Topmost="False"
        WindowStartupLocation="Manual"
        WindowStyle="None">
    <Border x:Name="CardSurface" Padding="18" Background="#F21A2638" CornerRadius="8">
        <Border.RenderTransform>
            <TranslateTransform x:Name="ShakeTransform" />
        </Border.RenderTransform>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="TitleText"
                       Grid.Row="0"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="#F2F4F8"
                       Text="Sub2API 余额" />

            <Grid Grid.Row="1" Margin="0,9,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="132" />
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="BalanceText"
                           Grid.Column="0"
                           FontFamily="Consolas, Segoe UI"
                           FontSize="30"
                           FontWeight="SemiBold"
                           Foreground="#F2F4F8"
                           Text="--"
                           TextAlignment="Left"
                           Width="132"
                           VerticalAlignment="Center" />

                <views:DamageStreamCanvas x:Name="DamageStream"
                                          Grid.Column="2"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Center"
                                          Height="42"
                                          Width="92" />
            </Grid>

            <Grid Grid.Row="2" Margin="0,13,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="100" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" FontSize="12" Foreground="#B8C2D1" Text="Today's spend" />
                <TextBlock x:Name="TodaySpendText"
                           Grid.Column="1"
                           FontFamily="Consolas, Segoe UI"
                           FontSize="15"
                           Foreground="#F2F4F8"
                           Text="--"
                           TextAlignment="Right" />
            </Grid>

            <Grid Grid.Row="3" Margin="0,5,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="100" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" FontSize="12" Foreground="#B8C2D1" Text="Today's requests" />
                <TextBlock x:Name="TodayRequestsText"
                           Grid.Column="1"
                           FontFamily="Consolas, Segoe UI"
                           FontSize="15"
                           Foreground="#F2F4F8"
                           Text="--"
                           TextAlignment="Right" />
            </Grid>

            <Grid Grid.Row="4" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Ellipse x:Name="ConnectionDot"
                         Grid.Column="0"
                         Width="10"
                         Height="10"
                         VerticalAlignment="Center" />

                <TextBlock x:Name="ConnectionText"
                           Grid.Column="1"
                           Margin="6,0,0,0"
                           FontSize="12"
                           Foreground="#B8C2D1"
                           Text="Online"
                           Width="78"
                           VerticalAlignment="Center" />

                <TextBlock x:Name="UpdatedText"
                           Grid.Column="2"
                           FontSize="12"
                           Foreground="#8E9AAB"
                           Text="Updated --"
                           TextAlignment="Right"
                           VerticalAlignment="Center" />
            </Grid>
        </Grid>
    </Border>
</Window>
