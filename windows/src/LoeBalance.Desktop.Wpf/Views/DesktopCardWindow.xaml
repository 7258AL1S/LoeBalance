<Window x:Class="LoeBalance.Desktop.Wpf.Views.DesktopCardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="326"
        Height="218"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Title="Sub2API Balance"
        WindowStyle="None">
    <Border Padding="18" Background="#E91A2638" CornerRadius="8">
        <StackPanel>
            <TextBlock Foreground="White" FontSize="16" FontWeight="SemiBold" Text="Sub2API Balance" />
            <TextBlock x:Name="BalanceText" Margin="0,12,0,0" Foreground="White" FontSize="30" FontWeight="SemiBold" Text="--" />
            <TextBlock Margin="0,16,0,0" Foreground="#B8C2D1" Text="Windows desktop card shell" />
        </StackPanel>
    </Border>
</Window>
